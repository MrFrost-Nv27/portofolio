# Copy this file to .env and adjust as needed.
# Shared by both the Go server (cmd/server, cmd/seed) and vite.config.ts's
# dev proxy — one file configures both halves of the app.

# Port the Go server listens on. Vite's dev proxy forwards /api and
# /uploads to this same port, so change it here only — no need to touch
# vite.config.ts.
PORT=8080

# Database driver: sqlite | mysql | postgres. Defaults to sqlite — zero
# extra setup, just works. All repositories are written against GORM's
# dialect-agnostic API, so switching driver requires no code changes.
DB_DRIVER=sqlite

# Used only when DB_DRIVER=sqlite. File path relative to the process's
# working directory (the repo root, when run via `go run`/`air`/the built
# binary from root).
DB_PATH=data/portfolio.db

# Used only when DB_DRIVER=mysql or postgres — full DSN, ignored for sqlite.
# Examples:
#   mysql:    user:password@tcp(127.0.0.1:3306)/portfolio?charset=utf8mb4&parseTime=True&loc=Local
#   postgres: host=127.0.0.1 user=postgres password=postgres dbname=portfolio port=5432 sslmode=disable
DB_DSN=

# Directory for admin-uploaded content (profile photo, CV, project images),
# served at /uploads/*.
UPLOADS_DIR=uploads

# Set to true only once the app is served over HTTPS (directly or behind a
# TLS-terminating reverse proxy) — browsers drop Secure cookies over plain
# HTTP, which would silently break admin login.
SESSION_COOKIE_SECURE=false

# Read once by `go run ./cmd/seed -create-admin` to set the initial admin
# password non-interactively. Unset after first use; never commit a real
# value here.
ADMIN_INITIAL_PASSWORD=
